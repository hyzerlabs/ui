{
	"name": "@hyzer-labs/sv",
	"description": "Svelte CLI add-on for @hyzer-labs/ui — install, wire the stylesheets, scaffold hyzer.config.ts",
	"version": "0.1.3",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"demo-create": "sv create demo --types ts --template minimal --no-add-ons --no-install",
		"demo-add": "pnpm build && sv add file:../ --cwd demo --no-git-check --no-install",
		"demo-add:ci": "pnpm build && sv add file:../=config:yes+utilities:yes --cwd demo --no-git-check --no-download-check --no-install",
		"build": "tsdown",
		"prepublishOnly": "npm run build",
		"test": "vitest run"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"default": "./dist/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"sv": "^0.17.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/sv-utils": "^0.3.3",
		"@types/node": "^25.9.1",
		"sv": "^0.17.0",
		"tsdown": "^0.22.1",
		"vitest": "^4.1.8"
	},
	"keywords": [
		"sv-add",
		"svelte",
		"sveltekit"
	],
	"homepage": "https://design.hyzer.sh",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyzerlabs/ui.git",
		"directory": "sv-addon"
	}
}
