{
	"name": "@hyzer-labs/ui",
	"version": "0.0.0",
	"description": "Headless, accessible Svelte 5 component library",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@10.12.3",
	"engines": {
		"node": ">=22.18"
	},
	"homepage": "https://design.hyzer.sh",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyzerlabs/ui.git"
	},
	"bugs": {
		"url": "https://github.com/hyzerlabs/ui/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"hyzer": "./dist/cli/hyzer.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./config": {
			"types": "./dist/config/index.d.ts",
			"default": "./dist/config/index.js"
		},
		"./tokens": {
			"types": "./dist/tokens/index.d.ts",
			"default": "./dist/tokens/index.js"
		},
		"./tokens.css": "./dist/tokens/tokens.css",
		"./reset.css": "./dist/theme/reset.css",
		"./icons": {
			"types": "./dist/icons/index.d.ts",
			"svelte": "./dist/icons/index.js",
			"default": "./dist/icons/index.js"
		},
		"./icons/*": {
			"types": "./dist/icons/generated/*.svelte.d.ts",
			"svelte": "./dist/icons/generated/*.svelte",
			"default": "./dist/icons/generated/*.svelte"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"default": "./dist/utils/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/types/index.js"
		},
		"./theme": "./dist/theme/theme.css",
		"./theme/*.css": "./dist/theme/*.css"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"package": "pnpm run gen:icons && svelte-kit sync && svelte-package",
		"prepublishOnly": "pnpm run package && publint",
		"prepare": "svelte-kit sync && pnpm run gen:icons",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --run",
		"test:e2e": "playwright install chromium --with-deps && playwright test",
		"test": "pnpm run test:unit && pnpm run test:e2e",
		"gen:tokens": "tsx scripts/gen-tokens.ts",
		"gen:icons": "tsx scripts/gen-icons.ts"
	},
	"peerDependencies": {
		"svelte": "^5.7.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.4",
		"@changesets/cli": "^2.31.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"lucide": "1.25.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"zod": "^4.4.3"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"ui",
		"components",
		"headless",
		"accessible"
	]
}
